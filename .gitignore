# Raw source data — re-downloadable via scripts/fetch_sources.py (checksummed)
data/raw/
data/interim/

# Build outputs. The Parquet tables ARE committed (see negations below) so the
# notebook runs from a fresh clone; the GeoPackage (23 MB) and SQLite (27 MB)
# builds are not. They contain identical content and are regenerated by
# `python -m hutrackdb build`. Both are SQLite files carrying embedded write
# timestamps, so no two builds are byte-identical — committing them would add a
# full new blob to git history on every rebuild.
data/processed/*
!data/processed/parquet/
data/processed/parquet/*
!data/processed/parquet/*.parquet

.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
.DS_Store
